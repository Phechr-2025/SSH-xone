# Central project settings. Edit this file before publishing the repository.
PROJECT_GITHUB_OWNER="${PROJECT_GITHUB_OWNER:-Phechr-2025}"
PROJECT_GITHUB_REPO="${PROJECT_GITHUB_REPO:-SSH-xone}"
PROJECT_GITHUB_BRANCH="${PROJECT_GITHUB_BRANCH:-main}"
PROJECT_BRAND="${PROJECT_BRAND:-SSH-one}"
PROJECT_SLUG="${PROJECT_SLUG:-ssh-one}"
PROJECT_CONFIG_DIR="${PROJECT_CONFIG_DIR:-/etc/ssh-one}"
PROJECT_RAW_BASE_URL="${PROJECT_RAW_BASE_URL:-https://raw.githubusercontent.com/${PROJECT_GITHUB_OWNER}/${PROJECT_GITHUB_REPO}/${PROJECT_GITHUB_BRANCH}}"
PROJECT_REPOSITORY_URL="${PROJECT_REPOSITORY_URL:-https://github.com/${PROJECT_GITHUB_OWNER}/${PROJECT_GITHUB_REPO}}"
PROJECT_API_BASE_URL="${PROJECT_API_BASE_URL:-https://api.github.com/repos/${PROJECT_GITHUB_OWNER}/${PROJECT_GITHUB_REPO}}"
PROJECT_VERSION_FILE="${PROJECT_VERSION_FILE:-/home/ver}"
PROJECT_CONTACT_EMAIL="${PROJECT_CONTACT_EMAIL:-}"
PROJECT_CLOUDFLARE_EMAIL="${PROJECT_CLOUDFLARE_EMAIL:-}"
PROJECT_CLOUDFLARE_API_KEY="${PROJECT_CLOUDFLARE_API_KEY:-}"
PROJECT_CLOUDFLARE_DOMAIN="${PROJECT_CLOUDFLARE_DOMAIN:-}"

# Upstream download locations for optional components.
SLOWDNS_RAW_BASE_URL="${SLOWDNS_RAW_BASE_URL:-https://raw.githubusercontent.com/NevermoreSSH/hopp/main}"
ADDONS_RELEASE_BASE_URL="${ADDONS_RELEASE_BASE_URL:-https://github.com/NevermoreSSH/addons/releases/download}"
SHADOWSOCKS_PLUGIN_RAW_BASE_URL="${SHADOWSOCKS_PLUGIN_RAW_BASE_URL:-https://raw.githubusercontent.com/NevermoreSSH/Shadowsocks-Plugin/main}"
BBRPLUS_RELEASE_BASE_URL="${BBRPLUS_RELEASE_BASE_URL:-https://github.com/NevermoreSSH/BBRplus/releases/download}"
SWAPRAM_SCRIPT_URL="${SWAPRAM_SCRIPT_URL:-https://raw.githubusercontent.com/NevermoreSSH/swapram/main/swapram.sh}"
XRAY_CHANGER_BASE_URL="${XRAY_CHANGER_BASE_URL:-https://raw.githubusercontent.com/NevermoreSSH/Xcore-custompath/main}"

# UDP Custom upstream assets used by the VVV installer.
UDP_CUSTOM_BINARY_URL="${UDP_CUSTOM_BINARY_URL:-https://raw.githubusercontent.com/NevermoreSSH/Vergil/main/Tunnel/udp-custom-linux-amd64}"
UDP_CUSTOM_CONFIG_URL="${UDP_CUSTOM_CONFIG_URL:-https://raw.githubusercontent.com/NevermoreSSH/Vergil/main/Tunnel/config.json}"
UDP_CUSTOM_ROOT="${UDP_CUSTOM_ROOT:-/root/udp}"
UDP_CUSTOM_SERVICE="${UDP_CUSTOM_SERVICE:-udp-custom}"
UDP_CUSTOM_DEFAULT_PORT="${UDP_CUSTOM_DEFAULT_PORT:-36712}"
UDP_CUSTOM_GROUP="${UDP_CUSTOM_GROUP:-udp-custom}"

#!/bin/bash
set -o nounset

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    echo "Run this uninstaller as root." >&2
    exit 1
fi

CONFIG_FILE="${PROJECT_CONFIG_FILE:-/etc/ssh-one/config.env}"
if [ -r "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
fi
UDP_CUSTOM_GROUP="${UDP_CUSTOM_GROUP:-udp-custom}"

backup="/root/ssh-one-uninstall-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
echo "This removes the VPN script's managed services, menu commands, and configuration folders."
echo "OpenSSH and operating-system packages are retained so the current administration session stays available."
echo "A backup of existing configuration files will be written to: $backup"
read -r -p 'Type REMOVE to continue: ' confirmation
[ "$confirmation" = REMOVE ] || { echo "Cancelled."; exit 0; }
read -r -p 'Also delete all UDP Custom accounts? [y/N]: ' delete_udp_accounts

backup_paths=(
    etc/xray etc/trojan-go etc/slowdns etc/wireguard etc/openvpn
    etc/stunnel5 etc/stunnel etc/default/sslh etc/sslh etc/issue.net
    etc/ssh/sshd_config etc/ssh-one etc/systemd/system root/udp
)
existing_paths=()
for path in "${backup_paths[@]}"; do
    [ -e "/$path" ] && existing_paths+=("$path")
done
if [ "${#existing_paths[@]}" -gt 0 ]; then
    tar -czf "$backup" -C / "${existing_paths[@]}" || { echo "Backup failed; no files were removed." >&2; exit 1; }
else
    echo "No matching configuration files were found to back up."
fi

services=(
    udp-custom badvpn1 badvpn2 badvpn3 ws-nontls ws-tls ws-ovpn
    sslh stunnel5 squid squid3 xray trojan-go server-sldns client-sldns
    dnstt-server dnstt-client xl2tpd ipsec pptpd accel-ppp wg-quick@wg0 openvpn
)
for service in "${services[@]}"; do
    systemctl disable --now "$service" >/dev/null 2>&1 || true
done

unit_files=(
    udp-custom.service badvpn1.service badvpn2.service badvpn3.service
    ws-nontls.service ws-tls.service ws-ovpn.service sslh.service
    stunnel5.service xray.service trojan-go.service server-sldns.service
    client-sldns.service dnstt-server.service dnstt-client.service
)
for unit in "${unit_files[@]}"; do
    rm -f "/etc/systemd/system/$unit"
done
systemctl daemon-reload

if [[ "$delete_udp_accounts" =~ ^[Yy]$ ]]; then
    udp_gid="$(getent group "$UDP_CUSTOM_GROUP" | awk -F: 'NR == 1 {print $3}')"
    if [ -n "$udp_gid" ]; then
        while IFS=: read -r username _ _ _ _ _ _; do
            userdel "$username" >/dev/null 2>&1 || true
        done < <(getent passwd | awk -F: -v gid="$udp_gid" '$4 == gid {print $0}')
        groupdel "$UDP_CUSTOM_GROUP" >/dev/null 2>&1 || true
    fi
fi

commands=(
    menu menuinfo updatemenu udp-custom-menu uninstall-vpn
    sshovpnmenu l2tpmenu pptpmenu sstpmenu wgmenu ssmenu ssrmenu
    vmessmenu vlessmenu grpcmenu grpcupdate trmenu trgomenu setmenu
    slowdnsmenu running ipsaya sl-fix restart install-sldns
    addssh trialssh delssh member delexp cekssh speedtest info ram
    renewssh autokill ceklim tendang clearlog changeport portovpn
    portwg porttrojan portsstp portsquid portvlm wbmn xp swapkvm
    addvmess addvless addtrojan addgrpc cekgrpc delgrpc renewgrpc
    delvmess delvless deltrojan cekvmess cekvless cektrojan
    renewvmess renewvless renewtrojan certv2ray addtrgo deltrgo
    renewtrgo cektrgo addwg delwg renewwg addl2tp dell2tp addpptp
    delpptp addsstp delsstp ceksstp addss delss renewss cekss addssr
    delssr renewssr
)
for command in "${commands[@]}"; do
    rm -f "/usr/bin/$command" "/usr/sbin/$command"
done

managed_dirs=(
    /etc/xray /etc/trojan-go /etc/slowdns /etc/wireguard /etc/openvpn
    /root/udp /etc/ssh-one
)
for path in "${managed_dirs[@]}"; do
    rm -rf -- "$path"
done

if [ -f /etc/crontab ]; then
    sed -i -E '/^[^#]*[[:space:]]root[[:space:]]+(delexp|xp|restart|clearlog|sslh-fix-reboot)([[:space:]]|$)/d' /etc/crontab
fi
rm -f /home/ver
systemctl daemon-reload
echo "Managed services and script files were removed."
echo "The configuration backup is at $backup. Shared OS packages and user data were retained."
